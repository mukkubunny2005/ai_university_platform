# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Use your Render PostgreSQL connection string or local PostgreSQL)
# Example for Render: postgresql://username:password@dpg-xxxxx.singapore-postgres.render.com/ai_university_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_university?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="ai_university_phase1_super_secure_access_token_secret_key_2026"
JWT_REFRESH_SECRET="ai_university_phase1_super_secure_refresh_token_secret_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Application URL for CORS
FRONTEND_URL="http://localhost:3000"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             Role     @default(STUDENT)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student Student?
  faculty Faculty?

  @@map("users")
}

model Student {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId    String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semester     Int        @default(1)
  batchId      String?
  batch        Batch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sectionId    String?
  section      Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("students")
}

model Faculty {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId    String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subjects Subject[]

  @@map("faculty")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students Student[]
  faculty  Faculty[]
  courses  Course[]
  batches  Batch[]
  sections Section[]

  @@map("departments")
}

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  description  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subjects Subject[]
  batches  Batch[]
  sections Section[]
  courseSemesters CourseSemester[]

  @@map("courses")
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  credits   Int      @default(3)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseSemesters CourseSemester[]

  @@map("subjects")
}

model AcademicYear {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections        Section[]
  courseSemesters CourseSemester[]

  @@map("academic_years")
}

model Batch {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  startYear    Int
  endYear      Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  students Student[]
  sections Section[]

  @@map("batches")
}

model Section {
  id             String       @id @default(uuid())
  name           String
  semesterNumber Int
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  batchId        String
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  maxCapacity    Int          @default(60)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  students Student[]

  @@unique([departmentId, courseId, semesterNumber, academicYearId, batchId, name])
  @@map("sections")
}

model CourseSemester {
  id             String       @id @default(uuid())
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semesterNumber Int
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([courseId, semesterNumber, subjectId, academicYearId])
  @@map("course_semesters")
}

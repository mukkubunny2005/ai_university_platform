# ==========================================
# AI UNIVERSITY PLATFORM — ENVIRONMENT SETUP
# ==========================================

# -----------------
# BACKEND (.env)
# -----------------
PORT=4000
NODE_ENV=development

# Database Connection
# Use Render PostgreSQL URL or local PostgreSQL instance
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/ai_university?schema=public"

# JWT Authentication Secrets (Generate secure random 256-bit strings in production)
JWT_ACCESS_SECRET="ai_university_phase1_super_secure_access_token_secret_key_2026"
JWT_REFRESH_SECRET="ai_university_phase1_super_secure_refresh_token_secret_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Application Origin for CORS
FRONTEND_URL="http://localhost:3000"

# -----------------
# FRONTEND (.env.local)
# -----------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
